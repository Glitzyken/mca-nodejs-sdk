{
  "name": "mca-nodejs-sdk",
  "version": "1.0.0",
  "description": "Unofficial Node.js SDK tailored for MyCover.ai. Seamlessly integrate and supercharge your insurance offerings with Africa's foremost insure-tech infrastructure.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "dev": "rm -rf dist && tsup --watch",
    "build": "rm -rf dist && tsup",
    "prepublishOnly": "npm run build",
    "prepare": "husky install || true",
    "docs": "docsify serve docs"
  },
  "keywords": [
    "mycoverai",
    "insurance",
    "sdk"
  ],
  "author": "Kenneth Jimmy",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glitzyken/mca-nodejs-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Glitzyken/mca-nodejs-sdk/issues"
  },
  "homepage": "https://glitzyken.github.io/mca-nodejs-sdk"
}
